4. Book Allocation
public class Main {

    public static void main(String[] args) {

        int[] pages = {12, 34, 67, 90};
        int students = 2;

        int left = 0;
        int right = 0;

        for (int page : pages) {
            left = Math.max(left, page);
            right += page;
        }

        int answer = right;

        while (left <= right) {

            int mid = left + (right - left) / 2;

            if (canAllocate(pages, students, mid)) {
                answer = mid;
                right = mid - 1;
            } else {
                left = mid + 1;
            }
        }

        System.out.println(answer);
    }

    static boolean canAllocate(int[] pages, int students, int maxPages) {

        int studentCount = 1;
        int currentPages = 0;

        for (int page : pages) {

            if (currentPages + page <= maxPages) {
                currentPages += page;
            } else {
                studentCount++;
                currentPages = page;
            }
        }

        return studentCount <= students;
    }
}
